{
  "name": "tradernex-backend",
  "version": "1.0.0",
  "description": "TraderNex Backend API - Sistema de gestão de investimentos Forex e Crypto",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --legacy-watch --polling-interval 1000 src/server.js",
    "create-db": "node src/config/createDatabase.js",
    "init-db": "node src/config/createDatabase.js && node src/config/initDB.js",
    "seed": "node src/config/seed.js",
    "migrate": "node src/config/runMigration.js",
    "migrate:selected-plan": "node src/config/runMigrationSelectedPlanId.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=tests/unit"
  },
  "keywords": [
    "trading",
    "forex",
    "crypto",
    "investment"
  ],
  "author": "TraderNex Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^6.3.3"
  }
}
