# Dockerfile.dev (Adicione estas linhas antes do COPY)
FROM node:18-alpine

# Defina o diretório de trabalho no container
WORKDIR /app

# DEBUG: Mostra o conteúdo do contexto de build antes de copiar
RUN ls -la .
RUN ls -la .. 

# Copie os arquivos de definição de dependências
COPY package*.json ./

# DEBUG: Mostra o que foi copiado
RUN ls -la .

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Expose port for Vite dev server
EXPOSE 3000

# Start Vite dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
